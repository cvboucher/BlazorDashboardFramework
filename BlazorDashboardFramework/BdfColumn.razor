    public void Dispose()
    {
        editModeService.EditModeChanged -= OnEditModeChanged;
        sortableListService.ItemAdded -= SortableListService_ItemAdded;
        sortableListService.ItemRemoved -= SortableListService_ItemRemoved;
    }
}
