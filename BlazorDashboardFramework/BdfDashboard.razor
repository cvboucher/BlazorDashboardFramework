@using System.Text.Json
@implements IDisposable

<div class="dashboard-header">
    <div class="d-flex justify-content-between">
        <h1 class="dashboard-title">@Value?.Title</h1>
        <div class="float-end">
            @if (editModeService.EditMode)
            {
                    <button type="button" class="btn btn-outline-secondary" @onclick="AddNewWidget" title="Add new widget"><i class="bi bi-plus-square"></i></button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="EditDashboard" title="Edit dashboard"><i class="bi bi-gear"></i></button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="SaveChanges" title="Save dashboard"><i class="bi bi-floppy"></i></button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="DeleteDashboard" title="Delete this dashboard"><i class="bi bi-trash3"></i></button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelChanges" title="Cancel changes"><i class="bi bi-x-square"></i></button>
            }
            else if (!ReadOnly)
            {
                    <button type="button" class="btn btn-outline-secondary" @onclick="EnableEditMode" title="Enable edit mode"><i class="bi bi-pencil-square"></i></button>
            }
        </div>
    </div>
</div>
<div class="container-fluid">
    <CascadingValue Value="this">
        @if (Value != null)
        {
            <CascadingValue Value="Value">
                <CascadingValue Value="Value.Rows">
                    <BdfRows />
                </CascadingValue>
            </CascadingValue>
        }
    </CascadingValue>
</div>
@if (editModeService.EditMode)
{
    <BdfDashboardForm @bind-Dashboard="@Value" @ref="@bdfDashboardForm" />
    <BdfWidgetSelector @ref="@bdfWidgetSelector" WidgetTypeSelected="AddSelectedWidget" />
}

@code {
    [Parameter] public Dashboard Value { get; set; } = new();
    //[Parameter] public EventCallback<Dashboard> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    // [Parameter] public string AddWidgetIconCss { get; set; } = "bi bi-plus-square";
    // [Parameter] public string EditDashbaordIconCss { get; set; } = "bi bi-gear";
    // [Parameter] public string SaveDashboardIconCss { get; set; } = "bi bi-save";
    // [Parameter] public string DeleteDashboardIconCss { get; set; } = "bi bi-trash";
    // [Parameter] public string CancelChangesIconCss { get; set; } = "bi bi-x-square";
    // [Parameter] public string EditModeIconCss { get; set; } = "bi bi-pencil-square";
    [Parameter] public EventCallback<Dashboard> OnDashboardSaved { get; set; }
    [Parameter] public EventCallback<Dashboard> OnDashboardDeleted { get; set; }
    [Parameter] public string? DefaultLayout { get; set; }
    /// <summary>Ask for confirmation before deleting the dashboard or removing a widget (ADF enableConfirmDelete).</summary>
    [Parameter] public bool ConfirmDelete { get; set; } = true;
    /// <summary>Open a new widget's configuration dialog as soon as it is added (ADF edit.immediate).</summary>
    [Parameter] public bool EditNewWidgets { get; set; } = true;

    [Inject] public EditModeService editModeService { get; set; } = default!;
    [Inject] public StructureService layoutService { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;

    private string? pendingConfigWidgetId;

    private BdfDashboardForm? bdfDashboardForm { get; set; }
    private BdfWidgetSelector? bdfWidgetSelector { get; set; }

    private string? dashboardJson;

    protected override void OnInitialized()
    {
        editModeService.EditModeChanged += OnEditModeChanged;
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        // if (Value == null && !string.IsNullOrWhiteSpace(DefaultLayout))
        //     Value = layoutService.GetLayout(DefaultLayout);
        // if (Value == null)
        //     Value = layoutService.GetDefaultLayout();
        base.OnParametersSet();
    }

    private async void OnEditModeChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(() => StateHasChanged());
    }

    public async Task AddNewWidget()
    {
        if (bdfWidgetSelector != null && Value != null)
            await bdfWidgetSelector.Open();
    }

    private async Task AddSelectedWidget
    
    
    
    (WidgetType widgetType)
    {
        await Task.Delay(0);
        var column = Value?.FindFirstColumn();
        if (column == null)
            return;
        var widget = widgetType.GetInstance();
        column.Widgets.Insert(0, widget);
        if (EditNewWidgets && widgetType.EditComponent != null)
            pendingConfigWidgetId = widget.WidgetInstanceId;
        StateHasChanged();
    }

    /// <summary>True (once) if the widget was just added and its config dialog should open.</summary>
    public bool TakePendingConfig(string widgetInstanceId)
    {
        if (pendingConfigWidgetId == null || pendingConfigWidgetId != widgetInstanceId)
            return false;
        pendingConfigWidgetId = null;
        return true;
    }

    /// <summary>Browser confirm dialog; always true when <see cref="ConfirmDelete"/> is off.</summary>
    public async Task<bool> ConfirmAsync(string message)
    {
        if (!ConfirmDelete)
            return true;
        try
        {
            return await JS.InvokeAsync<bool>("confirm", message);
        }
        catch (JSException)
        {
            return true;
        }
    }

    public async Task EditDashboard()
    {
        if (bdfDashboardForm != null)
            await bdfDashboardForm.Open();
    }

    public async Task SaveChanges()
    {
        editModeService.EditMode = false;
        await OnDashboardSaved.InvokeAsync(Value);
    }

    public async Task DeleteDashboard()
    {
        if (!await ConfirmAsync($"Are you sure you want to delete the dashboard \"{Value?.Title}\"?"))
            return;
        await OnDashboardDeleted.InvokeAsync(Value);
    }

    public void CancelChanges()
    {
        if (!string.IsNullOrWhiteSpace(dashboardJson))
            Value = Dashboard.FromJson(dashboardJson)
                ?? new Dashboard() { Title = "Dashboard" };
        //await ValueChanged.InvokeAsync(Value);
        editModeService.EditMode = false;
        StateHasChanged();
    }

    public void EnableEditMode()
    {
        //await Task.Delay(0);
        if (Value != null)
            dashboardJson = Value.ToJson();
        editModeService.EditMode = true;
    }
       

    public void Dispose()
    {
        editModeService.EditModeChanged -= OnEditModeChanged;
    }
}
