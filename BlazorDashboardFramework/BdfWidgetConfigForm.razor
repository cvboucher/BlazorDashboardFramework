@using System.Text.Json
<BootstrapModal @ref=@modalDialog
                Title="@WidgetInstance.Title"
                OnOpen="OnModalOpen">
    <BodyContent>
        @if (editContext != null)
        {
            <EditForm EditContext="editContext" 
                    OnValidSubmit="OnValidSubmitClicked" 
                    class="form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <InputText @bind-Value=@WidgetInstance.Title
                               class="form-control" />
                </div>
                @if (widgetType != null && widgetType.EditComponent != null )
                {
                    <DynamicComponent Type="widgetType.EditComponent" Parameters="parameters" />
                }
                <div class="float-end">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="OnCancelClicked">Cancel</button>
                </div>
            </EditForm>
        }
    </BodyContent>
</BootstrapModal>
@code {
    [CascadingParameter] public WidgetInstance WidgetInstance { get; set; } = default!;
    [CascadingParameter] public WidgetType widgetType { get; set; } = default!;
    [CascadingParameter] public BdfWidget bdfWidget { get; set; } = default!;
    //[Parameter] public EventCallback<WidgetInstance> WidgetInstanceChanged { get; set; } 

    //[Inject] public WidgetTypeService widgetTypeService { get; set; } = default!;

    private BootstrapModal modalDialog { get; set; } = default!;
    private EditContext? editContext = default!;
    //private WidgetType? widgetType;
    //private object? configObject;
    private Dictionary<string, object> parameters = new();

    public async Task Open()
    {
        await modalDialog.Open();
    }

    private async Task Close()
    {
        await modalDialog.Close();
        editContext = null;
        parameters.Clear();
    }

    private async Task OnValidSubmitClicked()
    {
        if (parameters.ContainsKey("Config"))
        {
            var configObject = parameters["Config"];
            if (configObject != null)
            {
                WidgetInstance.Config = JsonSerializer.SerializeToElement(configObject, new JsonSerializerOptions()
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                });
                WidgetInstance.OnConfigChanged();
                //bdfWidget.LoadWidgetConfig();
            }
        }
        // if (configObject != null)
        // {
        //     WidgetInstance.Config = JsonSerializer.SerializeToElement(configObject, new JsonSerializerOptions()
        //     {
        //         PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        //     });
        //     WidgetInstance.OnConfigChanged();
        //     //bdfWidget.LoadWidgetConfig();
        // }
        //await WidgetInstanceChanged.InvokeAsync(WidgetInstance);
        await Close();
    }

    private async Task OnCancelClicked()
    {
        await Close();
    }

    private async Task OnModalOpen()
    {
        await Task.Delay(0);
        try
        {
            editContext = new EditContext(WidgetInstance);
            parameters = new();
            if (widgetType.ConfigType != null)
            {
                // var configType = Type.GetType(widgetType.ConfigType.AssemblyQualifiedName!)
                //     ?? throw new Exception($"Unable to find type: {widgetType.ConfigType.AssemblyQualifiedName}");
                var configObject = WidgetInstance.GetConfig(widgetType.ConfigType);
                if (configObject != null)  
                    parameters.Add("Config", configObject);
            }
            
            //configObject = widgetType.GetConfig(WidgetInstance.Config);
            //if (configObject != null)
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}
