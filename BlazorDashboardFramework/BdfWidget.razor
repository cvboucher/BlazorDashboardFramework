    protected override void OnParametersSet()
    {
        try
        {
            if (Widget != null && (widgetType == null || widgetType.Type != Widget.Type))
            {
                widgetType = widgetTypeService.GetWidgetType(Widget.Type)
                    ?? throw new Exception($"Unknown widget type: {Widget.Type}");
                HideHeader = widgetType.HideHeader;
                Collapsed = widgetType.Collapsed;
                HideWidget = widgetType.HideWidget;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"In BdfWidget-OnParametersSet: {ex.InnerException?.Message ?? ex.Message}");
        }
        finally
        {
            base.OnParametersSet();
        }

    }

