@implements IDisposable
<CascadingValue Value="@this">
    <CascadingValue Value="widgetType">
        @if (!HideWidget || editModeService.EditMode)
        {

            <div class="card mb-3">
                @if (!HideHeader || editModeService.EditMode)
                {
                    <div class="card-header hover-container d-flex justify-content-between">
                        <h5>@Widget.Title</h5>

                        <div class="float-end hover-effect fs-6">
                            @if (editModeService.EditMode)
                            {
                                <i class="bi bi-arrows-move drag-handle btn btn-sm btn-outline-secondary" title="Change widget location"></i>
                                <button class="btn btn-sm btn-outline-secondary" title="Copy widget" @onclick="CopyWidget"><i class="bi bi-copy"></i></button>
                                <button class="btn btn-sm btn-outline-secondary" title="Edit widget configuration" @onclick="EditWidgetConfiguration"><i class="bi bi-gear"></i></button>
                                <button class="btn btn-sm btn-outline-secondary" title="Remove widget" @onclick="RemoveWidget"><i class="bi bi-trash"></i></button>
                            }
                            else
                            {
                                if (isIRefresh)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" Icon="refresh" title="Refresh content" @onclick="RefreshContent"><i class="bi bi-arrow-clockwise"></i></button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" title="Expand/collapse widget" @onclick="ExpandCollapseWidget"><i class="@($"bi {(Collapsed ? "bi-chevron-right" : "bi-chevron-down")}")"></i></button>
                            }
                        </div>
                    </div>
                }
                <div class="@(Collapsed ? "d-none" : null) card-body">
                    @if (widgetType != null)
                    {
                        @* if (widgetType.ConfigType == null)
                        { *@
                            <DynamicComponent @ref="dynamicComponentRef" Type="@widgetType.DisplayComponent" @key="@($"{Widget.WidgetInstanceId}-DisplayComponent")" />  @* Parameters = "widgetParameters" *@
                        @* }
                        else
                        {
                            <CascadingValue Value="configObject" Name="Config">
                                <DynamicComponent @ref="dynamicComponentRef" Type="@widgetType.DisplayComponent" @key="@($"{Widget.WidgetInstanceId}-DisplayComponent")" />
                            </CascadingValue>
                        } *@
                    }
                    else
                    {
                        <h1>@Widget.Type</h1>
                    }
                </div>
            </div>

        }
        @if (editModeService.EditMode)
        {
            <BdfWidgetConfigForm @ref="@bdfWidgetConfigForm" /> @* WidgetInstanceChanged="OnWidgetInstanceChanged" /> *@
        }
    </CascadingValue>
</CascadingValue>
@code {
