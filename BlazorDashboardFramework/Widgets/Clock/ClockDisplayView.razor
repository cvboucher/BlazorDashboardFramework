    //     : new ClockConfig();

    [Inject] ClockWidgetService clockWidgetService { get; set; } = default!;
    //[Inject] WidgetTypeService widgetTypeService { get; set; } = default!;
    [Inject] public EditModeService editModeService { get; set; } = default!;

    //private bool ranOnce;

    private ClockConfig? Config;

    protected override void OnInitialized()
    {
        clockWidgetService.CurrentDateTimeChanged += ClockWidgetService_OnCurrentDateTimeChanged;
        WidgetInstance.ConfigChanged += WidgetInstance_OnConfigChanged;
        editModeService.EditModeChanged += EditModeService_OnEditModeChanged;
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        try
        {
            if (Config == null)
            {
                LoadConfig();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ClockDisplayView OnParametersSetAsync: {ex}");
        }
        finally
        {
            base.OnParametersSet();
        }
        
    }

