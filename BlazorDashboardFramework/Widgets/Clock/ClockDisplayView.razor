@implements IDisposable
<div class="bdf-clock text-center">
    <div class="bdf-clock-time">@GetTimeString()</div>
    @if (!string.IsNullOrWhiteSpace(dateString))
    {
        <div class="bdf-clock-date">@dateString</div>
    }
</div>
@code {
    [CascadingParameter] public BdfWidget bdfWidget { get; set; } = default!;
    [CascadingParameter] public WidgetInstance WidgetInstance { get; set; } = default!;
    [CascadingParameter] public WidgetType widgetType { get; set; } = default!;

    [Inject] ClockWidgetService clockWidgetService { get; set; } = default!;
    [Inject] public EditModeService editModeService { get; set; } = default!;

    private ClockConfig? Config;
    private string? dateString;

    protected override void OnInitialized()
    {
        clockWidgetService.CurrentDateTimeChanged += ClockWidgetService_OnCurrentDateTimeChanged;
        WidgetInstance.ConfigChanged += WidgetInstance_OnConfigChanged;
        editModeService.EditModeChanged += EditModeService_OnEditModeChanged;
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        if (Config == null)
            LoadConfig();
        base.OnParametersSet();
    }

    private void LoadConfig()
    {
        Config = WidgetInstance.GetConfig<ClockConfig>();
    }

    private void WidgetInstance_OnConfigChanged(object? sender, EventArgs e)
    {
        LoadConfig();
        InvokeAsync(StateHasChanged);
    }

    private void EditModeService_OnEditModeChanged(object? sender, EventArgs e)
    {
        LoadConfig();
        InvokeAsync(StateHasChanged);
    }

    private string GetTimeString()
    {
        var now = clockWidgetService.CurrentDateTime;
        try
        {
            dateString = Config?.DatePattern == null
                ? MomentFormatter.Format(now, ClockConfig.DefaultDatePattern)
                : MomentFormatter.Format(now, Config.DatePattern);
            // Clocks saved by earlier versions of this framework used a .NET format string.
            if (!string.IsNullOrWhiteSpace(Config?.Format) && Config.TimePattern == ClockConfig.DefaultTimePattern)
                return now.ToString(Config.Format);
            return MomentFormatter.Format(now, string.IsNullOrWhiteSpace(Config?.TimePattern)
                ? ClockConfig.DefaultTimePattern
                : Config.TimePattern);
        }
        catch (FormatException)
        {
            return now.ToString("T");
        }
    }

    private async void ClockWidgetService_OnCurrentDateTimeChanged(object? sender, DateTime e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        clockWidgetService.CurrentDateTimeChanged -= ClockWidgetService_OnCurrentDateTimeChanged;
        WidgetInstance.ConfigChanged -= WidgetInstance_OnConfigChanged;
        editModeService.EditModeChanged -= EditModeService_OnEditModeChanged;
    }
}
