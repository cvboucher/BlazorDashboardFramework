    //     //     await InvokeAsync(() => StateHasChanged());
    //     // }
    //     // await base.OnParametersSetAsync();
    // }

    private void LoadConfig()
    {
        Config = WidgetInstance.GetConfig<ClockConfig>();
    }

    private void WidgetInstance_OnConfigChanged(object? sender, EventArgs e)
    {
        LoadConfig();
        InvokeAsync(() => StateHasChanged());
    }

    private void EditModeService_OnEditModeChanged(object? sender, EventArgs e)
    {
        LoadConfig();
        InvokeAsync(() => StateHasChanged());
    }


    private string GetClockFormat()
    {
        return string.IsNullOrWhiteSpace(Config?.Format)
            ? "T"
            : Config.Format;
    }

    private string GetClockString()
    {
        try
        {
            return clockWidgetService.CurrentDateTime.ToString(GetClockFormat());
        }
        catch (Exception)
        {
            return clockWidgetService.CurrentDateTime.ToString("T");
        }
    }

    private async void ClockWidgetService_OnCurrentDateTimeChanged(object? sender, DateTime e)
    {
        await InvokeAsync(() => StateHasChanged());
    }
      
    public void Dispose()
    {
        clockWidgetService.CurrentDateTimeChanged -= ClockWidgetService_OnCurrentDateTimeChanged;
        WidgetInstance.ConfigChanged -= WidgetInstance_OnConfigChanged;
        editModeService.EditModeChanged -= EditModeService_OnEditModeChanged;
    }
}
